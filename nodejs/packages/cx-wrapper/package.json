{
  "name": "cx-wrapper",
  "version": "0.0.1",
  "private": true,
  "description": "",
  "repository": "",
  "scripts": {
    "clean": "rimraf build/*",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts --fix",
    "prepare": "npm run compile",
    "compile": "tsc -p .",
    "test": "npm run compile && node --test test/*.test.cjs"
  },
  "keywords": [
    "opentelemetry",
    "awslambda",
    "nodejs",
    "tracing",
    "profiling",
    "instrumentation"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "files": [
    "*.js",
    "*.mjs",
    "*.d.ts",
    "*.d.mts",
    "package.json"
  ],
  "overrides": {
    "@opentelemetry/core": "$@opentelemetry/core",
    "@opentelemetry/instrumentation": "$@opentelemetry/instrumentation"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-configuration-propagators": "0.6.1",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.301.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.301.1",
    "@opentelemetry/instrumentation": "file:../../../opentelemetry-js/experimental/packages/opentelemetry-instrumentation/opentelemetry-instrumentation-0.301.1.tgz",
    "@opentelemetry/instrumentation-aws-lambda": "file:../../../opentelemetry-js-contrib-cx/packages/instrumentation-aws-lambda/opentelemetry-instrumentation-aws-lambda-0.77.1.tgz",
    "@opentelemetry/instrumentation-aws-sdk": "file:../../../opentelemetry-js-contrib-cx/packages/instrumentation-aws-sdk/opentelemetry-instrumentation-aws-sdk-0.80.0.tgz",
    "@opentelemetry/instrumentation-dns": "0.68.0",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-graphql": "0.73.0",
    "@opentelemetry/instrumentation-grpc": "0.301.1",
    "@opentelemetry/instrumentation-hapi": "0.71.0",
    "@opentelemetry/instrumentation-http": "file:../../../opentelemetry-js/experimental/packages/opentelemetry-instrumentation-http/opentelemetry-instrumentation-http-0.301.1.tgz",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-koa": "0.73.0",
    "@opentelemetry/instrumentation-mongodb": "file:../../../opentelemetry-js-contrib-cx/packages/instrumentation-mongodb/opentelemetry-instrumentation-mongodb-0.78.0.tgz",
    "@opentelemetry/instrumentation-mysql": "0.71.0",
    "@opentelemetry/instrumentation-net": "0.69.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-redis": "0.73.0",
    "@opentelemetry/propagator-aws-xray": "3.0.0",
    "@opentelemetry/propagator-b3": "3.1.1",
    "@opentelemetry/resource-detector-aws": "3.1.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "import-in-the-middle": "3.3.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.159",
    "@types/node": "22.15.30",
    "typescript": "5.9.3"
  }
}
