{
  "name": "@opentelemetry-lambda/sdk-layer",
  "version": "0.0.1",
  "private": true,
  "description": "Layer including OpenTelemetry SDK for use with AWS Lambda.",
  "repository": "open-telemetry/opentelemetry-lambda",
  "scripts": {
    "clean": "rimraf build/*",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint . --ext .ts --fix",
    "prepare": "npm run compile",
    "compile": "echo compiling nothing",
    "postcompile": "copyfiles 'node_modules/**' build/workspace/nodejs && copyfiles -f 'scripts/*' build/workspace && copyfiles -f 'build/src/*' build/workspace && cd build/workspace && bestzip ../layer.zip *"
  },
  "keywords": [
    "opentelemetry",
    "awslambda",
    "nodejs",
    "tracing",
    "profiling",
    "instrumentation"
  ],
  "author": "OpenTelemetry Authors",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "@opentelemetry/core": "$@opentelemetry/core",
    "@opentelemetry/instrumentation": "$@opentelemetry/instrumentation"
  },
  "dependencies": {
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/auto-configuration-propagators": "0.6.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@opentelemetry/core": "3.0.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation": "file:../../../opentelemetry-js/experimental/packages/opentelemetry-instrumentation/opentelemetry-instrumentation-0.300.0.tgz",
    "@opentelemetry/instrumentation-aws-lambda": "file:../../../opentelemetry-js-contrib-cx/packages/instrumentation-aws-lambda/opentelemetry-instrumentation-aws-lambda-0.76.0.tgz",
    "@opentelemetry/instrumentation-aws-sdk": "file:../../../opentelemetry-js-contrib-cx/packages/instrumentation-aws-sdk/opentelemetry-instrumentation-aws-sdk-0.79.0.tgz",
    "@opentelemetry/instrumentation-dns": "0.67.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-graphql": "0.72.0",
    "@opentelemetry/instrumentation-grpc": "0.300.0",
    "@opentelemetry/instrumentation-hapi": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-ioredis": "0.72.0",
    "@opentelemetry/instrumentation-koa": "0.72.0",
    "@opentelemetry/instrumentation-mongodb": "file:../../../opentelemetry-js-contrib-cx/packages/instrumentation-mongodb/opentelemetry-instrumentation-mongodb-0.77.0.tgz",
    "@opentelemetry/instrumentation-mysql": "0.70.0",
    "@opentelemetry/instrumentation-net": "0.68.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/instrumentation-redis": "0.72.0",
    "@opentelemetry/propagator-aws-xray": "3.0.0",
    "@opentelemetry/propagator-b3": "3.0.0",
    "@opentelemetry/resource-detector-aws": "3.0.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "cx-wrapper": "file:../cx-wrapper/cx-wrapper-0.0.1.tgz",
    "import-in-the-middle": "3.3.1"
  }
}
