#!/bin/bash

set -ef -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
handler_module="${_HANDLER%.*}"
possible_mjs_handler_file="${LAMBDA_TASK_ROOT}/${handler_module}.mjs"

detect_streaming_handler() {
  local streaming_metadata
  streaming_metadata="$(
    HANDLER_STRING="${CX_ORIGINAL_HANDLER:-$_HANDLER}" \
      node "${script_dir}/detect-streaming-handler.js" \
      | grep '^__CX_STREAMING_METADATA__' \
      | tail -n1 \
      | sed 's/^__CX_STREAMING_METADATA__//'
  )" || true

  if [ -n "$streaming_metadata" ]; then
    export CX_LAMBDA_HANDLER_STREAMING=true
    local high_water_mark
    high_water_mark="$(
      STREAMING_METADATA="$streaming_metadata" node <<'NODE'
try {
  const metadata = JSON.parse(process.env.STREAMING_METADATA);
  if (Number.isInteger(metadata.highWaterMark) && metadata.highWaterMark > 0) {
    console.log(metadata.highWaterMark);
  }
} catch (_) {}
NODE
    )"
    if [ -n "$high_water_mark" ]; then
      export CX_LAMBDA_HANDLER_STREAMING_HIGH_WATER_MARK="$high_water_mark"
    fi
  fi
}

detect_streaming_handler

# If the handler is in an .mjs file we need to use a loader hook. We can't detect it here because the corresponding env vars are not available at this point
if [ "$OTEL_NODEJS_HOOK" == "modules" ] || [ -f "$possible_mjs_handler_file" ]; then
    export NODE_OPTIONS="${NODE_OPTIONS} --experimental-loader=@opentelemetry/instrumentation/hook.mjs"
    # Disable node warnings caused by --experimental-loader
    export NODE_NO_WARNINGS=1
fi

if [[ $OTEL_RESOURCE_ATTRIBUTES != *"service.name="* ]]; then
  export OTEL_RESOURCE_ATTRIBUTES="service.name=${AWS_LAMBDA_FUNCTION_NAME},${OTEL_RESOURCE_ATTRIBUTES}"
fi

if [[ -z "${CX_ORIGINAL_HANDLER}" ]]; then
  export CX_ORIGINAL_HANDLER="${_HANDLER}"
fi
export _HANDLER="cx-wrapper.handler"

exec "$@"
